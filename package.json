  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "commander": "^13.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.9.3",
    "@vitest/coverage-v8": "^3.2.6",
    "typescript": "^6.0.3",
    "vitest": "^3.2.6"

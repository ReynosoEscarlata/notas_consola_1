{
  "name": "nota",
  "version": "0.1.0",
  "description": "CLI de notas personales con etiquetas, búsqueda y persistencia en SQLite.",
  "type": "module",
  "bin": {
    "nota": "./dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
